# URL de conexão para o banco de dados.
# Os scripts em app/database.py e alembic/env.py leem esta variável.
# Para trocar de banco, comente a linha que não está em uso e descomente a desejada.

# Exemplo para SQLite (padrão):
DATABASE_URL="sqlite:///./movie_app.db"

# Exemplo para PostgreSQL:
# Lembre-se de substituir 'user', 'password', 'host', 'port' e 'database_name'
# com os valores corretos para a sua instância do PostgreSQL.
# DATABASE_URL="postgresql://user:password@host:port/database_name"